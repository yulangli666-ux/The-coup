page {
  min-height: 100%;
  background: #120d1f;
  color: #f7eedc;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 28rpx;
  background:
    radial-gradient(circle at 16% 0%, rgba(181, 137, 48, 0.16), transparent 34%),
    linear-gradient(180deg, #171126 0%, #0e0b16 100%);
}

.primary-btn,
.secondary-btn,
.danger-btn,
.ghost-btn {
  border-radius: 8rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.primary-btn {
  color: #1d1420;
  background: linear-gradient(135deg, #f5ce73, #b78a31);
}

.secondary-btn {
  color: #f7eedc;
  background: #35294f;
}

.danger-btn {
  color: #fff3e5;
  background: #8b2635;
}

.ghost-btn {
  color: #e7cf98;
  background: rgba(255, 255, 255, 0.08);
}

button[disabled] {
  opacity: 0.45;
}

.panel {
  border: 1rpx solid rgba(245, 206, 115, 0.18);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}
