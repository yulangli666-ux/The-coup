.rules-page {
  display: flex;
  height: 100vh;
  padding: 56rpx 36rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  flex-direction: column;
  overflow: hidden;
  color: #f7eedc;
  background-color: #0d0b11;
  background-image: radial-gradient(circle at 50% 0%, #1c1726 0%, #0d0b11 72%);
}

.rules-hero {
  flex-shrink: 0;
  margin-bottom: 28rpx;
  text-align: center;
}

.title {
  display: block;
  color: #d4af37;
  font-family: "Times New Roman", serif;
  font-size: 72rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  line-height: 1.15;
  text-shadow: 0 8rpx 28rpx rgba(212, 175, 55, 0.35);
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #8c829c;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.rules-scroll {
  flex: 1;
  min-height: 0;
}

.section {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.14);
  border-radius: 14rpx;
  background: linear-gradient(145deg, #16121e 0%, #0f0c15 100%);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.5), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.04);
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #d4af37;
  font-size: 32rpx;
  font-weight: 900;
}

.paragraph {
  display: block;
  margin-bottom: 14rpx;
  color: #d8ccdf;
  font-size: 26rpx;
  line-height: 1.58;
}

.paragraph:last-child {
  margin-bottom: 0;
}

.step {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.step-index {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d4af37;
  border-radius: 50%;
  color: #d4af37;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.step-text {
  flex: 1;
  color: #d8ccdf;
  font-size: 26rpx;
  line-height: 1.5;
}

.rule-item,
.role-card {
  margin-bottom: 16rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(90, 79, 115, 0.5);
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.04);
}

.rule-item:last-child,
.role-card:last-child {
  margin-bottom: 0;
}

.item-name,
.role-name {
  display: block;
  margin-bottom: 8rpx;
  color: #f5ce73;
  font-size: 28rpx;
  font-weight: 900;
}

.item-desc {
  display: block;
  margin-top: 6rpx;
  color: #cdbfda;
  font-size: 24rpx;
  line-height: 1.48;
}

.role-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer {
  flex-shrink: 0;
  padding-top: 20rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  height: 92rpx;
  margin: 0;
  border: 1rpx solid rgba(212, 175, 55, 0.35);
  border-radius: 8rpx;
  color: #d4af37;
  background: linear-gradient(90deg, #231b30 0%, #16121e 100%);
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 92rpx;
}

.back-btn::after {
  display: none;
}
