.history {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.title {
  padding-top: 30rpx;
  color: #f5ce73;
  font-size: 46rpx;
  font-weight: 900;
}

.empty {
  padding: 60rpx 0;
  color: #cdbfda;
  text-align: center;
}

.record {
  padding: 20rpx;
}

.head {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #34284b;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

.info {
  min-width: 0;
  flex: 1;
}

.winner,
.meta,
.log {
  display: block;
}

.winner {
  color: #f5ce73;
  font-weight: 900;
}

.meta {
  margin-top: 6rpx;
  color: #cdbfda;
  font-size: 23rpx;
}

.logs {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255,255,255,0.08);
}

.log {
  padding: 5rpx 0;
  color: #efe2c5;
  font-size: 23rpx;
}
