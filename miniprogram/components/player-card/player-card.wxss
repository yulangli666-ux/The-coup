.player {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(245, 206, 115, 0.16);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}

.player.active {
  border-color: #f5ce73;
  box-shadow: 0 0 0 2rpx rgba(245, 206, 115, 0.18);
}

.player.out {
  opacity: 0.45;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #33284b;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.body {
  min-width: 0;
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.name {
  max-width: 250rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 700;
}

.host {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  color: #1d1420;
  background: #f5ce73;
  font-size: 22rpx;
}

.meta {
  display: flex;
  gap: 18rpx;
  margin-top: 6rpx;
  color: #cdbfda;
  font-size: 24rpx;
}
